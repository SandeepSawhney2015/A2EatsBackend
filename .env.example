# Copy this file to .env and fill in real values. Never commit .env.
APPLE_BUNDLE_ID=MichiganMakers.A2Eats
DATABASE_URL=postgresql://user:password@your-neon-host/dbname
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=15
RESTAURANT_SECRET_TOKEN=change-me-admin-token-for-creating-restaurants
REFRESH_EXPIRE_DAYS=60
REDIS_URL=redis://localhost:6379/0

# Photo storage (S3 or any S3-compatible service like Cloudflare R2)
S3_BUCKET=
S3_REGION=us-east-2
S3_ENDPOINT_URL=
S3_PUBLIC_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
